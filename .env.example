# =============================================================================
# Oracle Chat — Agent Configuration
# =============================================================================
# All settings are seeded into SQLite on first boot. After that, use the UI at
# /gui/settings to change prompts, language, and the active LLM provider.
# Restart the container for changes to LLM keys/models and connections to sync.

# ---------------------------------------------------------------------------
# LLM Providers
# ---------------------------------------------------------------------------
# Configure as many as you want. On startup, each one with both an API key
# and a model name will appear in the /gui/settings dropdown. The first one
# found becomes the default. You can switch the active provider from the UI
# without restarting.
# ---------------------------------------------------------------------------

GOOGLE_API_KEY="aaaaaaaaaaaaaaaaaaaaa"
GOOGLE_GEMINI_MODEL="google_genai:gemini-3-flash-preview"

#OPENAI_API_KEY="aaaaaaaaaaaaaaaaaaaaa"
#OPENAI_MODEL="gpt-4o"

#ANTHROPIC_API_KEY="aaaaaaaaaaaaaaaaaaaaa"
#ANTHROPIC_MODEL="claude-sonnet-4-6"

#DEEPSEEK_API_KEY="aaaaaaaaaaaaaaaaaaa"
#DEEPSEEK_MODEL="deepseek-chat"

#OPENROUTER_API_KEY="aaaaaaaaaaaaaaaaaaaaa"
#OPENROUTER_MODEL="auto"

# ---------------------------------------------------------------------------
# Language
# ---------------------------------------------------------------------------
# Replaces {LANGUAGE} in SYSTEM_PROMPT. Any value works (e.g. "Spanish",
# "English", "French"). The UI offers a shortcut list of the 10 most spoken
# languages for convenience.
# ---------------------------------------------------------------------------

LANGUAGE="Spanish"

# ---------------------------------------------------------------------------
# Tracing (optional)
# ---------------------------------------------------------------------------

LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""

# ---------------------------------------------------------------------------
# SQLcl
# ---------------------------------------------------------------------------
# Path to the SQLcl binary inside the container.
# SQLCL_CONNECTIONS: initial connections seeded into SQLcl on first boot.
# Format: [name,user/password@host:port/service][name2,user2/pass2@host:port/svc]
# After the first boot, connections are managed from /gui/settings.
# ---------------------------------------------------------------------------

SQLCL_PATH="/opt/sqlcl/bin/sql"
SQLCL_CONNECTIONS="[prod,user/password@10.0.0.1:1521/ORCL][dev,user/password@10.0.0.2:1521/XE]"

# ---------------------------------------------------------------------------
# System prompts
# ---------------------------------------------------------------------------
# SYSTEM_PROMPT:   main agent instructions. {LANGUAGE} is replaced at runtime.
# FILESYSTEM_PROMPT: how the agent should use its persistent filesystem memory.
# ---------------------------------------------------------------------------

SYSTEM_PROMPT="
You are Oracle, an expert assistant in SQL and databases. You help users query and manage their databases using SQL.
Make sure to always respond in {LANGUAGE}, no other language is allowed.
You always respond with information based on correct and optimized SQL queries, and you briefly explain your reasoning. When writing these queries, always use DBA views.
If the user provides additional information or context, you take it into account to generate your responses.
If you make a mistake, correct it in the next response.
You must not execute SQL queries that can modify the database, only read-only queries (SELECT).
You must not show SQL queries to the user.
"

FILESYSTEM_PROMPT="
Save relevant information about the user to your memory so you can use it in future conversations. 
At the beginning of a new conversation, review the stored information for that user and use it as context to generate more informed and personalized responses.
Organize the information logically into files and folders, using descriptive names. 
Whenever you write to the file system, ensure the information is well-structured and easily accessible for future reference.
"

# ---------------------------------------------------------------------------
# NiceGUI / Server
# ---------------------------------------------------------------------------

NICEGUI_STORAGE_SECRET="3V7AxYCB*qUfo#uive1*"